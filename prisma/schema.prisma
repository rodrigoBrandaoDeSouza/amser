// Amser — esquema do banco. Ver docs/database.md.
// Regra: toda entidade de negócio tem tenantId e é acessada via tenantDb() (src/lib/db.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  prospect
  onboarding
  active
  suspended
  deleted
}

enum UserRole {
  superadmin
  owner
  staff
}

enum UserStatus {
  active
  disabled
}

enum BrandingStatus {
  draft
  published
  archived
}

enum DepositType {
  none
  percent
  fixed
}

enum AppointmentStatus {
  aguardando_sinal
  pendente
  confirmado
  concluido
  cancelado
  nao_compareceu
  expirado
}

enum AppointmentSource {
  public
  manual
}

enum ExceptionType {
  block
  vacation
  holiday
}

enum PaymentStatus {
  pending
  paid
  expired
  refunded
  retained
  applied
  credited
}

enum ConnectionStatus {
  pending
  connected
  error
  disabled
}

enum MessageEvent {
  booking_confirmed
  payment_pending
  reminder
  presence_request
  rescheduled
  cancelled
  waitlist_offer
}

enum OutboxStatus {
  pending
  sent
  delivered
  read
  failed
  dead
  skipped
}

enum DepositRefundMode {
  refund
  credit
}

enum WaitlistStatus {
  waiting
  offered
  booked
  expired
  cancelled
}

enum DiscountType {
  percent
  fixed
}

enum InvoiceStatus {
  open
  paid
  void
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  limitsJson    Json           @default("{}") @map("limits_json")
  messageQuota  Int            @default(300) @map("message_quota")
  priceCents    Int            @map("price_cents")
  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id                      String            @id @default(cuid())
  name                    String
  slug                    String            @unique
  segment                 String
  status                  TenantStatus      @default(onboarding)
  planId                  String?           @map("plan_id")
  plan                    Plan?             @relation(fields: [planId], references: [id])
  timezone                String            @default("America/Sao_Paulo")
  description             String?
  phone                   String?
  whatsappContact         String?           @map("whatsapp_contact")
  address                 String?
  instagramHandle         String?           @map("instagram_handle")
  // Prévia para prospect (§4.1)
  previewToken            String?           @unique @map("preview_token")
  previewExpiresAt        DateTime?         @map("preview_expires_at") @db.Timestamptz(3)
  // Políticas de agenda (§8)
  minAdvanceMinutes       Int               @default(60) @map("min_advance_minutes")
  maxHorizonDays          Int               @default(60) @map("max_horizon_days")
  cancelLimitHours        Int               @default(24) @map("cancel_limit_hours")
  lateToleranceMinutes    Int               @default(10) @map("late_tolerance_minutes")
  slotStepMinutes         Int               @default(15) @map("slot_step_minutes")
  // Sinal (§9)
  holdMinutes             Int               @default(15) @map("hold_minutes")
  // Confirmação de presença (§8)
  presenceRequestHours    Int               @default(24) @map("presence_request_hours")
  presenceDeadlineHours   Int               @default(3) @map("presence_deadline_hours")
  autoReleaseUnconfirmed  Boolean           @default(false) @map("auto_release_unconfirmed")
  reminderHours           Int[]             @default([2]) @map("reminder_hours")
  cancellationPolicyText  String?           @map("cancellation_policy_text")
  // Fase 2 — políticas avançadas de sinal
  depositRefundMode       DepositRefundMode @default(refund) @map("deposit_refund_mode")
  lateCancelRetainPercent Int               @default(100) @map("late_cancel_retain_percent")
  noShowRetainPercent     Int               @default(100) @map("no_show_retain_percent")
  waitlistEnabled         Boolean           @default(true) @map("waitlist_enabled")
  // Fase 2 — suspensão por cobrança
  suspendedReason         String?           @map("suspended_reason")
  statusBeforeSuspension  TenantStatus?     @map("status_before_suspension")
  // LGPD e operação
  retentionMonths         Int               @default(24) @map("retention_months")
  deletionScheduledAt     DateTime?         @map("deletion_scheduled_at") @db.Timestamptz(3)
  supportAccessUntil      DateTime?         @map("support_access_until") @db.Timestamptz(3)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  branding            TenantBranding[]
  media               TenantMedia[]
  units               Unit[]
  users               User[]
  professionals       Professional[]
  categories          ServiceCategory[]
  services            Service[]
  customers           Customer[]
  appointments        Appointment[]
  paymentConnections  PaymentConnection[]
  whatsappConnections WhatsappConnection[]
  subscriptions       Subscription[]
  domains             TenantDomain[]
  coupons             Coupon[]
  waitlist            WaitlistEntry[]
  credits             CustomerCredit[]
  invoices            BillingInvoice[]
  instagram           InstagramConnection?

  @@index([status])
  @@map("tenants")
}

model TenantBranding {
  id                 String         @id @default(cuid())
  tenantId           String         @map("tenant_id")
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  themeJson          Json           @map("theme_json")
  sourceMetadataJson Json           @default("{}") @map("source_metadata_json")
  version            Int
  status             BrandingStatus @default(draft)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("tenant_branding")
}

model TenantMedia {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storageKey        String   @map("storage_key")
  kind              String   @default("photo") // "logo" | "photo"
  mimeType          String   @map("mime_type")
  sizeBytes         Int      @map("size_bytes")
  rightsConfirmed   Boolean  @default(false) @map("rights_confirmed")
  rightsConfirmedBy String?  @map("rights_confirmed_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenant_media")
}

model Unit {
  id            String          @id @default(cuid())
  tenantId      String          @map("tenant_id")
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  timezone      String          @default("America/Sao_Paulo")
  phone         String?
  active        Boolean         @default(true)
  sortOrder     Int             @default(0) @map("sort_order")
  professionals Professional[]
  appointments  Appointment[]
  waitlist      WaitlistEntry[]

  @@index([tenantId])
  @@map("units")
}

model User {
  id                 String        @id @default(cuid())
  tenantId           String?       @map("tenant_id")
  tenant             Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  email              String        @unique
  passwordHash       String        @map("password_hash")
  role               UserRole
  status             UserStatus    @default(active)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  emailVerifiedAt    DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  mfaSecretEncrypted String?       @map("mfa_secret_encrypted")
  mfaEnabledAt       DateTime?     @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Permissões configuráveis da equipe (staff)
  permissionsJson    Json          @default("{}") @map("permissions_json")
  /// Sessões emitidas antes disso são inválidas (troca/redefinição de senha)
  sessionsValidAfter DateTime?     @map("sessions_valid_after") @db.Timestamptz(3)
  professional       Professional?
  authTokens         AuthToken[]

  @@index([tenantId])
  @@map("users")
}

model Professional {
  id           String                @id @default(cuid())
  tenantId     String                @map("tenant_id")
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?               @unique @map("user_id")
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  unitId       String                @map("unit_id")
  unit         Unit                  @relation(fields: [unitId], references: [id])
  displayName  String                @map("display_name")
  active       Boolean               @default(true)
  services     ServiceProfessional[]
  workingHours WorkingHour[]
  exceptions   ScheduleException[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("professionals")
}

model ServiceCategory {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  services  Service[]

  @@index([tenantId])
  @@map("service_categories")
}

model Service {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId      String?               @map("category_id")
  category        ServiceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  durationMinutes Int                   @map("duration_minutes")
  bufferMinutes   Int                   @default(0) @map("buffer_minutes")
  priceCents      Int                   @map("price_cents")
  depositType     DepositType           @default(none) @map("deposit_type")
  // percent: 0–100; fixed: centavos
  depositValue    Int                   @default(0) @map("deposit_value")
  active          Boolean               @default(true)
  professionals   ServiceProfessional[]
  appointments    Appointment[]
  waitlist        WaitlistEntry[]

  @@index([tenantId, active])
  @@map("services")
}

model ServiceProfessional {
  tenantId       String       @map("tenant_id")
  serviceId      String       @map("service_id")
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professionalId String       @map("professional_id")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@index([tenantId])
  @@map("service_professionals")
}

model WorkingHour {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  professionalId String       @map("professional_id")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int // 0 = domingo … 6 = sábado
  startTime      String       @map("start_time") // "HH:MM" no fuso da unidade
  endTime        String       @map("end_time")

  @@index([tenantId, professionalId])
  @@map("working_hours")
}

model ScheduleException {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  // null = vale para todos os profissionais (ex.: feriado)
  professionalId String?       @map("professional_id")
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  type           ExceptionType
  reason         String?

  @@index([tenantId, startsAt])
  @@map("schedule_exceptions")
}

model Customer {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  phoneE164      String           @map("phone_e164")
  email          String?
  notes          String?
  tags           String[]         @default([])
  consentJson    Json             @default("{}") @map("consent_json")
  /// Business-scoped user ID do WhatsApp (recomendado pela Meta)
  whatsappUserId String?          @map("whatsapp_user_id")
  optedOutAt     DateTime?        @map("opted_out_at") @db.Timestamptz(3)
  anonymizedAt   DateTime?        @map("anonymized_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  appointments   Appointment[]
  credits        CustomerCredit[]
  waitlist       WaitlistEntry[]

  @@unique([tenantId, phoneE164])
  @@map("customers")
}

model Appointment {
  id                         String             @id @default(cuid())
  tenantId                   String             @map("tenant_id")
  tenant                     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId                     String             @map("unit_id")
  unit                       Unit               @relation(fields: [unitId], references: [id])
  customerId                 String             @map("customer_id")
  customer                   Customer           @relation(fields: [customerId], references: [id])
  professionalId             String             @map("professional_id")
  professional               Professional       @relation(fields: [professionalId], references: [id])
  serviceId                  String             @map("service_id")
  service                    Service            @relation(fields: [serviceId], references: [id])
  startsAt                   DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt                     DateTime           @map("ends_at") @db.Timestamptz(3)
  // endsAt + buffer de preparação; usado pela exclusion constraint
  blockEndsAt                DateTime           @map("block_ends_at") @db.Timestamptz(3)
  status                     AppointmentStatus
  source                     AppointmentSource  @default(public)
  priceSnapshotCents         Int                @map("price_snapshot_cents")
  depositAmountSnapshotCents Int                @default(0) @map("deposit_amount_snapshot_cents")
  couponId                   String?            @map("coupon_id")
  coupon                     Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountCents              Int                @default(0) @map("discount_cents")
  creditAppliedCents         Int                @default(0) @map("credit_applied_cents")
  holdExpiresAt              DateTime?          @map("hold_expires_at") @db.Timestamptz(3)
  confirmedPresenceAt        DateTime?          @map("confirmed_presence_at") @db.Timestamptz(3)
  presenceDeadlineAt         DateTime?          @map("presence_deadline_at") @db.Timestamptz(3)
  createdAt                  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  events                     AppointmentEvent[]
  payments                   Payment[]
  messages                   MessageOutbox[]
  credits                    CustomerCredit[]

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([professionalId, startsAt])
  @@map("appointments")
}

model AppointmentEvent {
  id            String      @id @default(cuid())
  tenantId      String      @map("tenant_id")
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorId       String?     @map("actor_id")
  eventType     String      @map("event_type")
  payloadJson   Json        @default("{}") @map("payload_json")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, appointmentId])
  @@map("appointment_events")
}

model PaymentConnection {
  id                   String           @id @default(cuid())
  tenantId             String           @map("tenant_id")
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             String
  encryptedCredentials String?          @map("encrypted_credentials")
  status               ConnectionStatus @default(pending)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, provider])
  @@map("payment_connections")
}

model Payment {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  appointmentId    String        @map("appointment_id")
  appointment      Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider         String
  providerChargeId String        @unique @map("provider_charge_id")
  amountCents      Int           @map("amount_cents")
  status           PaymentStatus @default(pending)
  pixCopyPaste     String?       @map("pix_copy_paste")
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  refundedAt       DateTime?     @map("refunded_at") @db.Timestamptz(3)
  // pagamento chegou depois do horário expirar: exige reembolso manual
  needsRefund      Boolean       @default(false) @map("needs_refund")
  retainedCents    Int           @default(0) @map("retained_cents")
  refundedCents    Int           @default(0) @map("refunded_cents")
  creditedCents    Int           @default(0) @map("credited_cents")
  providerRefundId String?       @map("provider_refund_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, status])
  @@map("payments")
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String   @map("external_id")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@map("webhook_events")
}

model WhatsappConnection {
  id                   String           @id @default(cuid())
  tenantId             String           @unique @map("tenant_id")
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             String
  phoneNumberId        String?          @map("phone_number_id")
  displayPhone         String?          @map("display_phone")
  encryptedCredentials String?          @map("encrypted_credentials")
  status               ConnectionStatus @default(pending)
  sendWindowStart      String           @default("08:00") @map("send_window_start")
  sendWindowEnd        String           @default("21:00") @map("send_window_end")
  wabaId               String?          @map("waba_id")
  verifiedName         String?          @map("verified_name")
  qualityRating        String?          @map("quality_rating")
  lastCheckedAt        DateTime?        @map("last_checked_at") @db.Timestamptz(3)
  lastError            String?          @map("last_error")
  /// Como foi conectado: "manual" (IDs + token), "embedded" (cadastro integrado da Meta, número só na API)
  /// ou "coexistence" (cadastro integrado com o número que continua no app WhatsApp Business). ADR 0015.
  onboarding           String           @default("manual")
  metaBusinessId       String?          @map("meta_business_id")
  /// Coexistência: quando pedimos à Meta a sincronização (obrigatória em até 24h após conectar).
  coexistenceSyncAt    DateTime?        @map("coexistence_sync_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("whatsapp_connections")
}

model MessageTemplate {
  id                 String       @id @default(cuid())
  tenantId           String       @map("tenant_id")
  eventType          MessageEvent @map("event_type")
  providerTemplateId String       @map("provider_template_id")
  language           String       @default("pt_BR")
  enabled            Boolean      @default(true)
  /// Status na Meta: APPROVED, PENDING, REJECTED, PAUSED, DISABLED… (UNKNOWN = nunca sincronizado)
  status             String       @default("UNKNOWN")
  category           String?
  rejectedReason     String?      @map("rejected_reason")
  metaTemplateId     String?      @map("meta_template_id")
  lastSyncedAt       DateTime?    @map("last_synced_at") @db.Timestamptz(3)

  @@unique([tenantId, eventType])
  @@map("message_templates")
}

model MessageOutbox {
  id                String       @id @default(cuid())
  tenantId          String       @map("tenant_id")
  appointmentId     String?      @map("appointment_id")
  appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  eventType         MessageEvent @map("event_type")
  toPhoneE164       String       @map("to_phone_e164")
  payloadJson       Json         @default("{}") @map("payload_json")
  idempotencyKey    String       @unique @map("idempotency_key")
  scheduledAt       DateTime     @map("scheduled_at") @db.Timestamptz(3)
  status            OutboxStatus @default(pending)
  attempts          Int          @default(0)
  lastError         String?      @map("last_error")
  providerMessageId String?      @unique @map("provider_message_id")
  sentAt            DateTime?    @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, scheduledAt])
  @@index([tenantId, createdAt])
  @@map("message_outbox")
}

model MessageUsage {
  tenantId     String @map("tenant_id")
  period       String // "YYYY-MM"
  messagesSent Int    @default(0) @map("messages_sent")
  quota        Int

  @@id([tenantId, period])
  @@map("message_usage")
}

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String             @map("tenant_id")
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String             @map("plan_id")
  plan        Plan               @relation(fields: [planId], references: [id])
  status      SubscriptionStatus
  periodStart DateTime           @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime           @map("period_end") @db.Timestamptz(3)
  trialEndsAt DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  graceUntil  DateTime?          @map("grace_until") @db.Timestamptz(3)
  canceledAt  DateTime?          @map("canceled_at") @db.Timestamptz(3)
  invoices    BillingInvoice[]

  @@index([tenantId])
  @@index([status, periodEnd])
  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  actorId   String?  @map("actor_id")
  action    String
  resource  String
  metaJson  Json     @default("{}") @map("meta_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================== Fase 2 ==============================

/// Domínio próprio do tenant (verificado por registro TXT).
model TenantDomain {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostname          String    @unique
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenant_domains")
}

model Coupon {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String
  discountType     DiscountType  @map("discount_type")
  /// percent: 1–100; fixed: centavos
  discountValue    Int           @map("discount_value")
  serviceIds       String[]      @default([]) @map("service_ids")
  validFrom        DateTime?     @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime?     @map("valid_until") @db.Timestamptz(3)
  maxRedemptions   Int?          @map("max_redemptions")
  redemptionsCount Int           @default(0) @map("redemptions_count")
  maxPerCustomer   Int           @default(1) @map("max_per_customer")
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  appointments     Appointment[]

  @@unique([tenantId, code])
  @@map("coupons")
}

/// Razão de créditos do cliente (sinal convertido em crédito). Saldo = soma.
model CustomerCredit {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String       @map("customer_id")
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amountCents   Int          @map("amount_cents")
  reason        String
  appointmentId String?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, customerId])
  @@map("customer_credits")
}

model WaitlistEntry {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId          String         @map("customer_id")
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId           String         @map("service_id")
  service             Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professionalId      String?        @map("professional_id")
  unitId              String?        @map("unit_id")
  unit                Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// "YYYY-MM-DD" no fuso da unidade
  date                String
  status              WaitlistStatus @default(waiting)
  offeredAt           DateTime?      @map("offered_at") @db.Timestamptz(3)
  offersCount         Int            @default(0) @map("offers_count")
  bookedAppointmentId String?        @map("booked_appointment_id")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, date, status])
  @@map("waitlist_entries")
}

model BillingInvoice {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId   String        @map("subscription_id")
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountCents      Int           @map("amount_cents")
  periodStart      DateTime      @map("period_start") @db.Timestamptz(3)
  periodEnd        DateTime      @map("period_end") @db.Timestamptz(3)
  dueAt            DateTime      @map("due_at") @db.Timestamptz(3)
  status           InvoiceStatus @default(open)
  provider         String
  providerChargeId String        @unique @map("provider_charge_id")
  pixCopyPaste     String?       @map("pix_copy_paste")
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([subscriptionId, periodStart])
  @@index([tenantId, status])
  @@map("billing_invoices")
}

model InstagramConnection {
  id             String    @id @default(cuid())
  tenantId       String    @unique @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  igUserId       String    @map("ig_user_id")
  username       String
  encryptedToken String    @map("encrypted_token")
  tokenExpiresAt DateTime  @map("token_expires_at") @db.Timestamptz(3)
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz(3)
  refreshedAt    DateTime? @map("refreshed_at") @db.Timestamptz(3)

  @@map("instagram_connections")
}

// ============================== Completo (pós-Fase 2) ==============================

/// Tokens de uso único (redefinição de senha, verificação de e-mail). Guardamos só o hash.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Feature flags: scope = "global" ou o id do tenant (sobrescreve o global).
model FeatureFlag {
  id        String   @id @default(cuid())
  key       String
  scope     String   @default("global")
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([key, scope])
  @@map("feature_flags")
}
