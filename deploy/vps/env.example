# Produção em VPS — copie para a raiz do projeto como ".env":
#   cp deploy/vps/env.example .env && nano .env
# Gere cada segredo com:  openssl rand -base64 32
# Valores com espaço ou < > ficam entre aspas.

# --- Domínio e HTTPS ---
APP_DOMAIN=app.seudominio.com.br
APP_URL=https://app.seudominio.com.br
# E-mail para avisos da Let's Encrypt (vencimento de certificado)
ACME_EMAIL=voce@seudominio.com.br

# --- Banco (Postgres roda na própria VPS) ---
POSTGRES_PASSWORD=troque-por-um-segredo-forte

# --- Segredos do app ---
SESSION_SECRET=gere-com-openssl-rand-base64-48
# Precisa ter exatamente 32 bytes em base64 (openssl rand -base64 32)
CREDENTIALS_KEY=
JOBS_SECRET=gere-com-openssl-rand-base64-32
PAYMENT_WEBHOOK_SECRET=gere-com-openssl-rand-base64-32
BILLING_WEBHOOK_SECRET=gere-com-openssl-rand-base64-32

# --- Superadmin (criado só no primeiro start) ---
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=senha-com-12-ou-mais-caracteres

# --- Versão 1.0: sem PSP ---
PAYMENT_PROVIDER=none
BILLING_PROVIDER=none

# --- WhatsApp oficial (Meta) ---
WHATSAPP_PROVIDER=meta
WHATSAPP_APP_SECRET=
# Texto aleatório de 16+ caracteres; o mesmo vai na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=

# --- Fotos: no disco da VPS (volume amser_uploads, entra no backup) ---
STORAGE_PROVIDER=local

# --- Outros ---
INSTAGRAM_PROVIDER=off
BRANDING_AI_PROVIDER=mock
# BRANDING_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Amser <nao-responda@seudominio.com.br>"

# --- Backup externo opcional (Cloudflare R2), usado por deploy/vps/backup.sh ---
# BACKUP_S3_BUCKET=amser-backups
# BACKUP_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
