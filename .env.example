# Banco (docker compose sobe em localhost:5433)
DATABASE_URL="postgresql://amser:amser@localhost:5433/amser"
# Banco usado pelos testes de integração (criado automaticamente)
TEST_DATABASE_URL="postgresql://amser:amser@localhost:5433/amser_test"

# URL pública da aplicação
APP_URL="http://localhost:3000"

# Segredo de sessão e tokens de ação (mín. 32 caracteres)
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio-123456"
# Chave para criptografar credenciais de integração (32 bytes em base64)
# gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""

# IA de identidade visual: "mock" (padrão) ou "anthropic"
BRANDING_AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# Pagamentos (Pix): "mock" (padrão). PSP real definido na Fase 0.
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-payment-webhook-secret"

# WhatsApp: "mock" (padrão) ou "meta"
WHATSAPP_PROVIDER="mock"
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="dev-verify-token"

# Armazenamento de mídia: "local" (dev) ou "s3" (produção)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".uploads"

# Segredo para o endpoint de jobs (cron do Railway)
JOBS_SECRET="dev-jobs-secret"
