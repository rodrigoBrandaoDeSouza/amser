# Banco (docker compose sobe na porta 5433). Use 127.0.0.1: no Windows o Docker Desktop pode travar conexões via IPv6 (localhost → ::1).
DATABASE_URL="postgresql://amser:amser@127.0.0.1:5433/amser"
# Banco usado pelos testes de integração (criado automaticamente)
TEST_DATABASE_URL="postgresql://amser:amser@127.0.0.1:5433/amser_test"

# URL pública da aplicação
APP_URL="http://localhost:3000"

# Segredo de sessão e tokens de ação (mín. 32 caracteres)
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio-123456"
# Chave para criptografar credenciais de integração (32 bytes em base64)
# gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""

# IA de identidade visual: "mock" (padrão) ou "anthropic"
BRANDING_AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# Pagamentos (Pix): "mock" (padrão). PSP real definido na Fase 0.
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-payment-webhook-secret"

# WhatsApp: "mock" (padrão) ou "meta"
WHATSAPP_PROVIDER="mock"
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="dev-verify-token"
# Cadastro integrado da Meta (botão "Conectar meu WhatsApp", coexistência; ADR 0015). No mock é simulado.
WHATSAPP_APP_ID=""
WHATSAPP_ES_CONFIG_ID=""

# Armazenamento de mídia: "local" (dev) ou "s3" (produção)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".uploads"

# Segredo para o endpoint de jobs (cron do Railway)
JOBS_SECRET="dev-jobs-secret"

# ---------------- Fase 2 ----------------
# Domínios extras do próprio Amser (separados por vírgula) — o resto é tratado como domínio próprio de tenant
APP_HOSTS=""
# Cobrança da assinatura do SaaS: "mock" (PSP de cobrança a definir na Fase 0)
BILLING_PROVIDER="mock"
BILLING_WEBHOOK_SECRET="dev-billing-webhook-secret"
# Instagram (Instagram Login): "off", "mock" (dev) ou "meta" (exige app Business + App Review)
INSTAGRAM_PROVIDER="mock"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_GRAPH_VERSION="v27.0"
# Cadastro self-service em /cadastro
SELF_SIGNUP_ENABLED="true"
DEFAULT_PLAN_NAME="Essencial"

# ---------------- Produção (pós-Fase 2) ----------------
# Fotos: "local" (dev) ou "s3" (AWS S3 ou Cloudflare R2)
# STORAGE_PROVIDER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX=""
# E-mail: "console" (dev — o link aparece no log) ou "smtp"
EMAIL_PROVIDER="console"
EMAIL_FROM="Amser <nao-responda@seudominio.com.br>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
# WhatsApp oficial (Graph API conferida na doc da Meta)
WHATSAPP_GRAPH_VERSION="v27.0"
# Quantos proxies confiáveis à frente do app (Railway = 1)
TRUST_PROXY_HOPS="1"

# ---------------- Versão 1.0 (sem provedor de Pix) ----------------
# PAYMENT_PROVIDER="none"   → sinal desativado (reservas confirmadas sem Pix)
# BILLING_PROVIDER="none"   → cobrança manual pelo superadmin
# Superadmin criado no primeiro deploy (bootstrap):
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
